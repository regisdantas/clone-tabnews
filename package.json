{
  "name": "clone-tabnews",
  "version": "1.0.0",
  "description": "Implementação do https://tabnews.com.br para o https://curso.dev",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "services:recreate": "npm run services:down && npm run services:up",
    "dev:local": "npm run services:up && next dev",
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write .",
    "test": "jest --runInBand",
    "test:watch": "jest --watch --runInBand",
    "test:watchAll": "jest --watchAll --runInBand",
    "migration:create": "node-pg-migrate create -m ./infra/migrations",
    "migration:up": "node-pg-migrate up -m ./infra/migrations --envPath .env.development",
    "migration:down": "node-pg-migrate down -m ./infra/migrations --envPath .env.development"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.4",
    "next": "^13.1.6",
    "node-pg-migrate": "^6.2.2",
    "pg": "^8.11.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "jest": "^29.6.2",
    "prettier": "^3.6.2"
  }
}
